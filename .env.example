# Copy this file to .env and replace the values as needed.
# This is the public authority seen by the browser; include :3080.
DSH_TRUSTED_HOST=localhost:3080

# Required for remote settings/credentials APIs; takes effect at image build time.
# Keep this enabled only behind Nginx Basic Auth.
DSH_ALLOW_REMOTE_PRIVILEGED=true

# Host directory mounted as the dsh workspace.
DSH_WORKSPACE_PATH=./workspace

# true/1/yes/on: HTTPS with a generated self-signed certificate.
# false/0/no/off: plain HTTP.
NGINX_SELF_SIGNED_CERT=true
NGINX_CERT_DAYS=365

# Hostname used for the self-signed certificate CN/SAN.
NGINX_SERVER_NAME=localhost

# Optional IP/CIDR allowlist. Enabled entries bypass Basic Auth;
# all other client IPs still require it. Keep disabled unless needed.
NGINX_IP_ALLOWLIST_ENABLED=false
NGINX_IP_ALLOWLIST=192.0.2.10,198.51.100.0/24

# Nginx protects the dsh Web UI with Basic Auth.
NGINX_BASIC_AUTH_USER=admin
# Generate with: openssl passwd -apr1 'replace-with-a-strong-password'
# Put the complete generated hash here, for example: '$apr1$...$...'
NGINX_BASIC_AUTH_HASH=REPLACE_WITH_APR1_HASH
